# Names only. Scripts read these from the environment and do not load this file by themselves.
# Set them in your shell, see README.md in this folder.

# download_bars.py and use_model.py, from a free Alpaca account (market data API)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Optional. Folder that holds data/ and runs/. Default: this folder.
KRONOS_VOL_DIR=

# Optional. Hugging Face token: only raises the download rate limit, the models are public.
HF_TOKEN=

# Optional, Windows. A number below your logical core count silences a joblib warning that LightGBM triggers.
LOKY_MAX_CPU_COUNT=
