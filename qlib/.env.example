# Names only. Scripts read these from the environment and do not load this file by themselves.
# Set them in your shell, see README.md in this folder.

# scripts/alpaca_download.py, from a free Alpaca account (market data API)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# For qrun on a fresh install: MLflow refuses its file store without this
MLFLOW_ALLOW_FILE_STORE=true

# For qrun: Qlib logs a git diff of the working folder; set this to the folder you run from
GIT_CEILING_DIRECTORIES=
