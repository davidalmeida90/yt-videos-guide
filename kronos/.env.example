# Names only. Scripts read these from the environment and do not load this file by themselves.
# Set the ones you need in your shell, see README.md in this folder.

# Agent 1, a2_claude.py, and the Claude Haiku arms of Agent 2
ANTHROPIC_API_KEY=

# Agent 3 (a2_llm.py, llm_three.py) and the DeepSeek arms of Agent 2
DEEPSEEK_API_KEY=

# Optional. Clone of shiyu-coder/Kronos. Default: a folder called Kronos beside this repository.
KRONOS_REPO=

# Optional. Python of the Kronos venv, for claude_tool_agent.py and t4_webui.py. Default: the Python running the script.
KRONOS_PYTHON=

# Optional. Clone of Glassbench. Default: a folder called glassbench beside this repository.
GLASSBENCH_REPO=

# Optional. Folder for the Glassbench copy. Default: a folder called glassbench-kronos-scratch beside this repository.
GLASSBENCH_SCRATCH=

# Optional. Python of the Glassbench venv, for run_trio.py. Default: the Python running the script.
GLASSBENCH_PYTHON=
