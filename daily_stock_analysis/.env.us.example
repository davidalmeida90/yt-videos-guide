# daily_stock_analysis on US stocks, fully in English.
# Copy into your clone as .env (or change these lines in the .env you made from .env.example).
# Keys are NOT here: set them in your shell (run.py) or as GitHub secrets (github_setup.ps1).

# your watchlist, US tickers, comma separated (the default is a list of Chinese A-shares)
STOCK_LIST=NVDA,AAPL,TSLA,JPM,XOM,KO,PLTR

# reports and market review in English, US market
REPORT_LANGUAGE=en
MARKET_REVIEW_REGION=us

# the model: Claude Haiku 5.5 (needs ANTHROPIC_API_KEY); for DeepSeek V4.1 Flash through OpenRouter use
# LITELLM_MODEL=openrouter/deepseek/deepseek-v4.1-flash (needs OPENROUTER_API_KEY)
LITELLM_MODEL=anthropic/claude-haiku-5-5
# Haiku 5.5 only takes the default temperature
ANTHROPIC_TEMPERATURE=1.0
LLM_TEMPERATURE=1.0

# the email sender's name (the default is Chinese); en_patch.py fixes the subject, units and punctuation
EMAIL_SENDER_NAME=Daily Stock Analysis

# no public SearXNG instances: news comes from Tavily (TAVILY_API_KEYS) or no news at all
SEARXNG_PUBLIC_INSTANCES_ENABLED=false
